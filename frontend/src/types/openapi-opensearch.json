            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "url",
          "title",
          "emoji",
          "type",
          "topics",
          "content",
          "summary",
          "created_at"
        ],
        "type": "object"
      },
      "BlogSearchResultItem": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "highlights": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "type": "object"
          },
          "score": {
            "format": "double",
            "type": "number"
          },
          "slug": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "url",
          "title",
          "emoji",
          "type",
          "topics",
