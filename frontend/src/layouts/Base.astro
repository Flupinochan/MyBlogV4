---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Flex from "../components/layout/Flex.astro";
import Avatar from "../components/avatar/Avatar.js";
import "../styles/global.css";
import CustomCursor from "../components/cursor/CustomCursor.js";
import ScrollToTopButton from "./ScrollToTopButton.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body class="flex flex-col">
    <CustomCursor client:load />
    <ScrollToTopButton />
    <Header />
    <Flex class="flex-1">
      <aside class="w-1/3 sticky top-0 h-dvh">
        <Avatar client:load />
      </aside>
      <main class="w-2/3">
        <slot />
      </main>
    </Flex>
    <Footer />
  </body>
</html>

<style>
  html {
    container-type: scroll-state;
    container-name: html-scroll-state;
    cursor: none;
  }
  body {
    color: white;
    background:
      linear-gradient(
        to right,
        rgba(255, 0, 200, 0.02) 0%,
        rgba(255, 0, 200, 0.02) 20%,
        rgba(0, 200, 255, 0.02) 50%,
        rgba(0, 200, 255, 0.02) 100%
      ),
      #0a0a0f;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
</style>
