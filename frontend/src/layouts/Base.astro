---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Flex from "../components/layout/Flex.astro";
import Avatar from "../components/avatar/Avatar.js";
import "../styles/global.css";
import ScrollToTopButton from "./ScrollToTopButton.astro";
import DarkModeGif from "./DarkModeGif.astro";
import Loading from "./Loading.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>Astro Basics</title>

    <script is:inline>
      const isDarkMode =
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", isDarkMode);
    </script>
  </head>
  <body
    class="flex flex-col bg-no-repeat bg-center bg-cover dark:bg-slate-900 text-slate-500"
  >
    <Loading />
    <DarkModeGif size={400} />
    <ScrollToTopButton />
    <Header />
    <Flex class="flex-1 pt-16">
      <aside class="w-1/3 sticky top-0 h-dvh">
        <Avatar client:load />
      </aside>
      <main class="w-2/3">
        <slot />
      </main>
    </Flex>
    <Footer />
  </body>
</html>
