---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Flex from "../components/layout/Flex.astro";
import Avatar from "../components/avatar/Avatar.tsx";
import "../styles/global.css";
import ScrollToTopButton from "./ScrollToTopButton.astro";
import Loading from "./Loading.astro";
import BackgroundParticles from "./BackgroundParticles.astro";
import ErrorDialog from "./error-dialog/ErrorDialog.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://github.com" />
    <link rel="preconnect" href="https://zenn.dev" />

    <title>Astro Basics</title>

    <script is:inline>
      // デフォルトはダークモード、localStorageにtheme設定がある場合はそれを優先
      const savedTheme = localStorage.getItem("theme");
      const isDarkMode = savedTheme !== null ? savedTheme === "dark" : true;
      document.documentElement.classList.toggle("dark", isDarkMode);
      if (savedTheme === null) {
        localStorage.setItem("theme", "dark");
      }
    </script>
  </head>
  <body
    class="flex flex-col bg-no-repeat bg-center bg-cover bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200"
  >
    <Loading />
    <ErrorDialog />
    <!-- <BackgroundParticles /> -->
    <!-- <ScrollToTopButton /> -->
    <Header />
    <Flex class="flex-1 pt-16 max-w-7xl mx-auto px-4 w-full">
      <aside class="w-1/3 sticky top-0 h-dvh">
        <Avatar client:load />
      </aside>
      <main class="w-2/3 m-4">
        <slot />
      </main>
    </Flex>
    <Footer />
  </body>
</html>
