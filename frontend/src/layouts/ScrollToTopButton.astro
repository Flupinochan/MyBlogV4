<button> 上へ戻る </button>

<style>
  button {
    position: fixed;
    z-index: 100;
    inset: auto 10px 20% auto;
    translate: calc(100% + 10px) 0;
    transition: translate 0.25s;
    backdrop-filter: blur(8px);
  }

  /*
  ボタン表示設定 (仕組みはheaderと同様)
    - 上へスクロール中 または
    - 上にスクロール不可能(ページ最上部) または
    - 下にスクロール不可能(ページ最下部)
  */
  @container html-scroll-state (
  scroll-state(scrolled: top) or 
  (not scroll-state(scrollable: top)) or 
  (not scroll-state(scrollable: bottom))
) {
    button {
      translate: 0 0;
    }
  }
</style>
