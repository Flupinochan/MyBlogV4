---
import Mail from "../components/icons/Mail.astro";
import Zenn from "../components/icons/Zenn.astro";
import Octcat from "../components/icons/Octcat.astro";
import Flex from "../components/layout/Flex.astro";
import SunMoon from "../components/icons/SunMoon.astro";
---

<header
  class="relative flex items-center justify-between h-16 pl-10 overflow-hidden bg-slate-800/10 backdrop-blur-sm"
>
  <nav>
    <ul class="flex">
      <li class="p-4 textWrapper" data-accent-color="cyan">
        <a href="#" class="backgroundImage">Profile</a>
      </li>
      <li class="p-4 textWrapper" data-accent-color="amber">
        <a href="#" class="backgroundImage">Blog</a>
      </li>
      <li class="p-4 textWrapper" data-accent-color="rose">
        <a href="#" class="backgroundImage">Tools</a>
      </li>
      <li class="p-4 textWrapper" data-accent-color="emerald">
        <a href="#" class="backgroundImage">GitHub</a>
      </li>
    </ul>
  </nav>
  <a
    href="#"
    class="text-6xl font-extrabold text-transparent [-webkit-text-stroke:1px_var(--color-slate-800)] dark:[-webkit-text-stroke-color:var(--color-slate-200)]"
    style="text-box: trim-start cap alphabetic"
  >
    METAL MENTAL
  </a>
  <Flex class="relative z-10 gap-4 pr-10 items-center">
    <button
      aria-label="ダークモードに切り替える"
      class="toggle-dark-mode group transform active:scale-95 transition-transform duration-150"
    >
      <SunMoon
        class="size-6 transition-all duration-300 group-hover:stroke-[2px] hover:brightness-75 dark:hover:brightness-125"
      />
    </button>
    <a
      aria-label="GitHubのプロフィールを新しいタブで開く"
      href="https://github.com/Flupinochan"
      target="_blank"
      rel="noopener"
      class="transform active:scale-95 transition-transform duration-150"
    >
      <Octcat
        width={24}
        height={24}
        class="hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </a>
    <a
      aria-label="Zennブログのプロフィールを新しいタブで開く"
      href="https://zenn.dev/metalmental"
      target="_blank"
      rel="noopener"
      class="transform active:scale-95 transition-transform duration-150"
    >
      <Zenn
        class="size-5 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </a>
    <a
      aria-label="メールを送信する"
      href="mailto:flupino@metalmental.net"
      class="transform active:scale-95 transition-transform duration-150"
    >
      <Mail
        class="size-6 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </a>
  </Flex>
</header>

<script>
  import { gsap } from "../components/lib/gsap";

  const header = document.querySelector("header");
  if (!header) throw new Error("Header element not found");

  // マウスに追従して背景色が変化するエフェクト
  header.addEventListener("mousemove", (e) => {
    const rect = header.getBoundingClientRect();
    header.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
    header.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
  });
  header.addEventListener("mouseleave", () => {
    header.style.setProperty("--mouse-x", "-9999px");
    header.style.setProperty("--mouse-y", "-9999px");
  });

  // ダークモード切替
  let isAnimating = false;
  const toggleButton = header.querySelector("button.toggle-dark-mode");
  toggleButton?.addEventListener("click", async () => {
    if (isAnimating) return;
    isAnimating = true;
    const enable =
      "startViewTransition" in document &&
      window.matchMedia("(prefers-reduced-motion: no-preference)").matches;

    if (!enable) {
      document.documentElement.classList.toggle("dark");
      isAnimating = false;
      return;
    }

    const root = document.documentElement;

    const last = localStorage.getItem("theme-switch");
    if (last && !isNaN(+last)) {
      const diff = Date.now() - +last;

      if (diff > 3 * 60 * 1000) {
        root.classList.remove("-animated");
      } else {
        root.classList.add("-animated");
      }
    }

    localStorage.setItem("theme-switch", Date.now().toString());
    root.classList.add("is-theme-switching");

    try {
      await document.startViewTransition(() => {
        root.classList.toggle("dark");
      }).finished;
    } finally {
      // view-transition-nameは実行時だけ付与して、完了後に削除すること!!
      root.classList.remove("is-theme-switching");

      const isTurningDark = !root.classList.contains("dark");
      const targetShape = isTurningDark ? "#target-moon" : "#target-sun";
      const activePath = document.getElementById("active-path");
      gsap.to(activePath, {
        morphSVG: targetShape,
        duration: 0.8,
        ease: "expo.inOut",
        overwrite: true,
      });
      isAnimating = false;
    }
  });
</script>

<style>
  header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    transition:
      translate 0.25s,
      background 0.25s ease;
    background: radial-gradient(
      circle 220px at var(--mouse-x) var(--mouse-y),
      color-mix(
        in srgb,
        var(--spotlight-color, var(--color-violet-500)) 12%,
        transparent
      ),
      transparent 80%
    );
    --spotlight-color: var(--color-violet-500);
    --mouse-x: -9999px;
    --mouse-y: -9999px;
  }

  header:has([data-accent-color="cyan"]:hover) {
    --spotlight-color: var(--color-cyan-500);
  }
  header:has([data-accent-color="amber"]:hover) {
    --spotlight-color: var(--color-amber-500);
  }
  header:has([data-accent-color="rose"]:hover) {
    --spotlight-color: var(--color-rose-500);
  }
  header:has([data-accent-color="emerald"]:hover) {
    --spotlight-color: var(--color-emerald-500);
  }
  header:has([data-accent-color="violet"]:hover) {
    --spotlight-color: var(--color-violet-500);
  }

  [data-accent-color="cyan"] {
    --underline-color: var(--color-cyan-500);
    --text-fill-color: var(--color-cyan-500);
  }
  [data-accent-color="amber"] {
    --underline-color: var(--color-amber-500);
    --text-fill-color: var(--color-amber-500);
  }
  [data-accent-color="rose"] {
    --underline-color: var(--color-rose-500);
    --text-fill-color: var(--color-rose-500);
  }
  [data-accent-color="emerald"] {
    --underline-color: var(--color-emerald-500);
    --text-fill-color: var(--color-emerald-500);
  }
  [data-accent-color="violet"] {
    --underline-color: var(--color-violet-500);
    --text-fill-color: var(--color-violet-500);
  }

  /* 
  header非表示設定
    - 下へスクロール中 かつ
    - 下にスクロール可能
   */
  @container html-scroll-state (
  scroll-state(scrolled: bottom) and
  scroll-state(scrollable: bottom)
) {
    header {
      translate: 0 -100%;
    }
  }

  /*
  header表示設定
    - 上へスクロール中 または
    - 上にスクロール不可能(ページ最上部) または
    - 下にスクロール不可能(ページ最下部)
  */
  @container html-scroll-state (
  scroll-state(scrolled: top) or 
  (not scroll-state(scrollable: top)) or 
  (not scroll-state(scrollable: bottom))
) {
    header {
      translate: 0 0;
    }
  }

  /* underline animation and text fill animation */
  .backgroundImage {
    position: relative;
    display: inline-block;
    padding-bottom: 5px;
    color: inherit;
    background-image: linear-gradient(
      90deg,
      var(--text-fill-color, var(--color-violet-500)),
      var(--text-fill-color, var(--color-violet-500))
    );
    background-size: 0% 100%;
    background-position: left center;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    transition:
      background-size 0.3s ease-out,
      color 0.3s ease-out;
  }
  .textWrapper:hover .backgroundImage {
    color: transparent;
    background-size: 100% 100%;
    font-weight: 700;
  }
  .backgroundImage::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--underline-color, var(--color-violet-500));
    transition: width 0.3s ease-out;
  }
  .textWrapper:hover .backgroundImage {
    background-size: 100% 100%;
  }
  .textWrapper:hover .backgroundImage::after {
    width: 100%;
  }
</style>

<style is:global>
  /* View Transition change dark mode gif animation*/
  :root {
    --switch-duration: 1.75s;
    --switch-name: scale;
  }

  .-animated {
    --switch-duration: 1s;
    --switch-name: scale-fast;
  }

  .is-theme-switching {
    view-transition-name: theme-switch;
  }

  ::view-transition-group(theme-switch) {
    z-index: 100;
  }
  ::view-transition-new(theme-switch),
  ::view-transition-old(theme-switch) {
    animation: var(--switch-name) var(--switch-duration) both;
  }
  ::view-transition-new(theme-switch) {
    mask: url("/dark-mode.gif") center / 0 no-repeat;
  }

  @keyframes scale {
    0% {
      mask-size: 0;
    }
    10% {
      mask-size: 25vmax;
    }
    90% {
      mask-size: 25vmax;
    }
    100% {
      mask-size: 750vmax;
    }
  }

  @keyframes scale-fast {
    0% {
      mask-size: 0;
    }
    10% {
      mask-size: 25vmax;
    }
    87.5% {
      mask-size: 25vmax;
    }
    100% {
      mask-size: 750vmax;
    }
  }
</style>
