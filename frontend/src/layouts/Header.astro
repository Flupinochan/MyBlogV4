---
import Mail from "../components/icons/Mail.astro";
import Zenn from "../components/icons/Zenn.astro";
import Moon from "../components/icons/Moon.astro";
import Octcat from "../components/icons/Octcat.astro";
import Sun from "../components/icons/Sun.astro";
import Flex from "../components/layout/Flex.astro";
---

<header
  class="relative flex items-center justify-between h-16 pl-10 overflow-hidden bg-slate-800/10 backdrop-blur-sm"
>
  <nav>
    <ul class="flex">
      <li class="p-4 textWrapper" data-cursor-color="cyan">
        <a href="#" class="backgroundImage">Profile</a>
      </li>
      <li class="p-4 textWrapper" data-cursor-color="amber">
        <a href="#" class="backgroundImage">Blog</a>
      </li>
      <li class="p-4 textWrapper" data-cursor-color="rose">
        <a href="#" class="backgroundImage">Tools</a>
      </li>
      <li class="p-4 textWrapper" data-cursor-color="emerald">
        <a href="#" class="backgroundImage">GitHub</a>
      </li>
    </ul>
  </nav>
  <div
    style="font-family: var(--font-family-geist)"
    class="text-4xl textWrapper"
    data-cursor-color="violet"
  >
    <a href="#" class="backgroundImage"> METAL MENTAL </a>
  </div>
  <Flex class="relative z-10 gap-4 pr-10 items-center">
    <button
      class="toggle-dark-mode transform active:scale-95 transition-transform duration-150"
    >
      <span class="dark:hidden">
        <Moon
          class="size-5 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
        />
      </span>
      <span class="hidden dark:block">
        <Sun
          class="size-6 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
        />
      </span>
    </button>
    <button class="transform active:scale-95 transition-transform duration-150">
      <Octcat
        width={24}
        height={24}
        class="hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </button>
    <button class="transform active:scale-95 transition-transform duration-150">
      <Zenn
        class="size-5 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </button>
    <button class="transform active:scale-95 transition-transform duration-150">
      <Mail
        class="size-6 hover:brightness-75 dark:hover:brightness-125 transition-all duration-300"
      />
    </button>
  </Flex>
</header>

<script>
  // header hover時のcolor effect
  import {
    getAccentColor,
    isAccentColor,
    type AccentColor,
  } from "./ThemeColor";

  const DEFAULT_ACCENT_COLOR: AccentColor = "violet";

  const header = document.querySelector("header");
  if (!header) throw new Error("Header element not found");

  header.style.setProperty(
    "--spotlight-color",
    getAccentColor(DEFAULT_ACCENT_COLOR),
  );

  header.addEventListener("mousemove", (e) => {
    const rect = header.getBoundingClientRect();
    header.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
    header.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
  });

  header.addEventListener("mouseleave", () => {
    header.style.setProperty("--mouse-x", "-9999px");
    header.style.setProperty("--mouse-y", "-9999px");
  });

  header.querySelectorAll("li[data-cursor-color]").forEach((element) => {
    const li = element as HTMLLIElement;
    const colorName = li.getAttribute("data-cursor-color");
    const resolvedColor =
      colorName && isAccentColor(colorName) ? colorName : DEFAULT_ACCENT_COLOR;

    li.style.setProperty("--underline-color", getAccentColor(resolvedColor));
    li.style.setProperty("--text-fill-color", getAccentColor(resolvedColor));

    li.addEventListener("mouseenter", () =>
      header.style.setProperty(
        "--spotlight-color",
        getAccentColor(resolvedColor),
      ),
    );
    li.addEventListener("mouseleave", () =>
      header.style.setProperty(
        "--spotlight-color",
        getAccentColor(DEFAULT_ACCENT_COLOR),
      ),
    );
  });

  // ダークモード切替
  const toggleButton = header.querySelector("button.toggle-dark-mode");
  toggleButton?.addEventListener("click", async () => {
    const overlay = document.getElementById("gif-overlay");
    const gif = document.getElementById("theme-gif");

    // GIF表示
    overlay?.classList.add("opacity-100");
    // 1秒待機
    await new Promise((resolve) => setTimeout(resolve, 1500));

    // GIF拡大
    gif?.classList.add("expand");
    await new Promise((resolve) => {
      gif?.addEventListener("transitionend", resolve, { once: true });
    });

    // ダークモード切替
    const isDarkMode = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDarkMode ? "dark" : "light");

    // GIF非表示
    overlay?.classList.remove("opacity-100");
    gif?.classList.remove("expand");
  });
</script>

<style>
  header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    transition:
      translate 0.25s,
      background 0.25s ease;
    background: radial-gradient(
      circle 220px at var(--mouse-x) var(--mouse-y),
      color-mix(
        in srgb,
        var(--spotlight-color, var(--color-violet-500)) 12%,
        transparent
      ),
      transparent 80%
    );

    --mouse-x: -9999px;
    --mouse-y: -9999px;
  }

  /* 
  header非表示設定
    - 下へスクロール中 かつ
    - 下にスクロール可能
   */
  @container html-scroll-state (
  scroll-state(scrolled: bottom) and
  scroll-state(scrollable: bottom)
) {
    header {
      translate: 0 -100%;
    }
  }

  /*
  header表示設定
    - 上へスクロール中 または
    - 上にスクロール不可能(ページ最上部) または
    - 下にスクロール不可能(ページ最下部)
  */
  @container html-scroll-state (
  scroll-state(scrolled: top) or 
  (not scroll-state(scrollable: top)) or 
  (not scroll-state(scrollable: bottom))
) {
    header {
      translate: 0 0;
    }
  }

  /* underline animation and text fill animation */
  .backgroundImage {
    position: relative;
    display: inline-block;
    padding-bottom: 5px;

    color: inherit;
    background-image: linear-gradient(
      90deg,
      var(--text-fill-color, var(--color-violet-500)),
      var(--text-fill-color, var(--color-violet-500))
    );
    background-size: 0% 100%;
    background-position: left center;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    transition:
      background-size 0.3s ease-out,
      color 0.3s ease-out;
  }

  .textWrapper:hover .backgroundImage {
    color: transparent;
    background-size: 100% 100%;
    font-weight: 700;
  }

  .backgroundImage::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--underline-color, var(--color-violet-500));
    transition: width 0.3s ease-out;
  }

  .textWrapper:hover .backgroundImage {
    background-size: 100% 100%;
  }

  .textWrapper:hover .backgroundImage::after {
    width: 100%;
  }
</style>
