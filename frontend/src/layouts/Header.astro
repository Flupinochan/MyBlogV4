---
import Moon from "../components/icons/Moon.astro";
import Sun from "../components/icons/Sun.astro";
---

<header class="flex items-center justify-between h-16 pl-10">
  <nav>
    <ul class="flex">
      <li
        class="p-4 textWrapper"
        data-cursor-color="cyan"
        data-cursor-shape="circle"
      >
        <a href="#" class="backgroundImage">Profile</a>
      </li>
      <li
        class="p-4 textWrapper"
        data-cursor-color="amber"
        data-cursor-shape="square"
      >
        <a href="#" class="backgroundImage">Blog</a>
      </li>
      <li
        class="p-4 textWrapper"
        data-cursor-color="rose"
        data-cursor-shape="star"
      >
        <a href="#" class="backgroundImage">Tools</a>
      </li>
      <li
        class="p-4 textWrapper"
        data-cursor-color="emerald"
        data-cursor-shape="diamond"
      >
        <a href="#" class="backgroundImage">GitHub</a>
      </li>
    </ul>
  </nav>
  <button
    class="toggle-dark-mode mr-10 transform active:scale-95 transition-transform duration-150"
  >
    <span class="dark:hidden">
      <Moon class="size-6" />
    </span>
    <span class="hidden dark:block">
      <Sun class="size-6" />
    </span>
  </button>
</header>

<script>
  // header hover時のcolor effect
  import { COLOR_MAP } from "./ThemeColor.js";
  const COLORS = COLOR_MAP as Record<string, string>;
  const DEFAULT_COLOR = `${COLOR_MAP["violet"]}30`;

  const header = document.querySelector("header");
  if (!header) throw new Error("Header element not found");

  header.addEventListener("mousemove", (e) => {
    const rect = header.getBoundingClientRect();
    header.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
    header.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
  });

  header.addEventListener("mouseleave", () => {
    header.style.setProperty("--mouse-x", "-9999px");
    header.style.setProperty("--mouse-y", "-9999px");
  });

  header.querySelectorAll("li[data-cursor-color]").forEach((element) => {
    const li = element as HTMLLIElement;
    const hex = COLORS[li.getAttribute("data-cursor-color") ?? ""] ?? null;
    const color = hex ? `${hex}30` : DEFAULT_COLOR;
    const underlineColor = hex ?? COLOR_MAP["violet"];

    // data-cursor-color属性に基づいてCSS変数を設定
    li.style.setProperty("--underline-color", underlineColor);
    li.style.setProperty("--text-fill-color", underlineColor);

    li.addEventListener("mouseenter", () =>
      header.style.setProperty("--spotlight-color", color),
    );
    li.addEventListener("mouseleave", () =>
      header.style.setProperty("--spotlight-color", DEFAULT_COLOR),
    );
  });

  // ダークモード切替
  const toggleButton = header.querySelector("button.toggle-dark-mode");
  toggleButton?.addEventListener("click", async () => {
    const overlay = document.getElementById("gif-overlay");
    const gif = document.getElementById("theme-gif");

    // GIF表示
    overlay?.classList.add("opacity-100");
    // 1秒待機
    await new Promise((resolve) => setTimeout(resolve, 1500));

    // GIF拡大
    gif?.classList.add("expand");
    await new Promise((resolve) => {
      gif?.addEventListener("transitionend", resolve, { once: true });
    });

    // ダークモード切替
    const isDarkMode = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDarkMode ? "dark" : "light");

    // GIF非表示
    overlay?.classList.remove("opacity-100");
    gif?.classList.remove("expand");
  });
</script>

<style>
  header {
    position: fixed;
    z-index: 100;
    inset: 0 0 auto;
    transition:
      translate 0.25s,
      background 0.25s ease;
    background:
      radial-gradient(
        circle 220px at var(--mouse-x) var(--mouse-y),
        var(--spotlight-color),
        transparent 80%
      ),
      rgb(31 41 55 / 10%);
    backdrop-filter: blur(8px);

    --mouse-x: -9999px;
    --mouse-y: -9999px;
    --spotlight-color: rgba(255 255 255 / 0.08);
  }

  /* 
  header非表示設定
    - 下へスクロール中 かつ
    - 下にスクロール可能
   */
  @container html-scroll-state (
  scroll-state(scrolled: bottom) and
  scroll-state(scrollable: bottom)
) {
    header {
      translate: 0 -100%;
    }
  }

  /*
  header表示設定
    - 上へスクロール中 または
    - 上にスクロール不可能(ページ最上部) または
    - 下にスクロール不可能(ページ最下部)
  */
  @container html-scroll-state (
  scroll-state(scrolled: top) or 
  (not scroll-state(scrollable: top)) or 
  (not scroll-state(scrollable: bottom))
) {
    header {
      translate: 0 0;
    }
  }

  /* underline animation and text fill animation */
  .backgroundImage {
    position: relative;
    display: inline-block;
    padding-bottom: 5px;

    color: inherit;
    background-image: linear-gradient(
      90deg,
      var(--text-fill-color, #8b5cf6),
      var(--text-fill-color, #8b5cf6)
    );
    background-size: 0% 100%;
    background-position: left center;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    transition:
      background-size 0.3s ease-out,
      color 0.3s ease-out;
  }

  .textWrapper:hover .backgroundImage {
    color: transparent;
    background-size: 100% 100%;
    font-weight: 700;
  }

  .backgroundImage::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--underline-color, #8b5cf6);
    transition: width 0.3s ease-out;
  }

  .textWrapper:hover .backgroundImage {
    background-size: 100% 100%;
  }

  .textWrapper:hover .backgroundImage::after {
    width: 100%;
  }
</style>
