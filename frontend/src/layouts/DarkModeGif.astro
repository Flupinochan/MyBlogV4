---

---

<div
  id="gif-overlay"
  class="fixed z-[-1] inset-0 flex items-center justify-center pointer-events-none opacity-0"
>
  <svg class="absolute w-0 h-0">
    <filter id="recolor-slate-900" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="
        0 0 0 0 0.0588
        0 0 0 0 0.0902
        0 0 0 0 0.1647
        0 0 0 1 0
      "
      ></feColorMatrix>
    </filter>
  </svg>

  <img
    id="theme-gif"
    src="/dark-mode.gif"
    class="[filter:url(#recolor-slate-900)] dark:invert dark:brightness-0 transition-transform duration-200"
  />
</div>

<style>
  #theme-gif.expand {
    transform: scale(20);
  }
</style>
