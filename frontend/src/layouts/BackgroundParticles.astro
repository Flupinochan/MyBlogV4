---

---

<div id="tsparticles" aria-hidden="true"></div>

<script>
  import { initParticlesEngine } from "@tsparticles/astro";
  import type { ISourceOptions } from "@tsparticles/engine";
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  const blurredParticleImage = "/particles.svg";

  const root = document.getElementById("tsparticles");
  if (!root) {
    throw new Error("Particles root element not found.");
  }

  const commonParticles: NonNullable<ISourceOptions["particles"]> = {
    paint: {
      fill: {
        enable: true,
      },
    },
    shape: {
      type: "image",
      options: {
        image: {
          src: blurredParticleImage,
          width: 64,
          height: 64,
          replaceColor: false,
          gif: false,
        },
      },
    },
    number: {
      value: 3,
    },
    opacity: {
      value: {
        min: 0.1,
        max: 0.5,
      },
    },
    move: {
      enable: true,
      speed: {
        min: 0.02,
        max: 0.25,
      },
    },
    size: {
      value: {
        min: 500,
        max: 1000,
      },
    },
    links: {
      enable: false,
    },
  };

  const buildOptions = (): ISourceOptions => ({
    autoPlay: true,
    fpsLimit: 30,
    detectRetina: true,
    pauseOnBlur: true,
    pauseOnOutsideViewport: true,
    fullScreen: {
      enable: true,
      zIndex: -1,
    },
    background: {
      color: {
        value: "transparent",
      },
    },
    particles: commonParticles,
  });

  await initParticlesEngine(async (engine) => {
    await Promise.all([loadSlim(engine)]);
  });

  await tsParticles.load({
    id: "tsparticles",
    options: buildOptions(),
  });
</script>
