---
import SectionHeading from "../../shared/SectionHeading.astro";
import LinkButton from "../../shared/LinkButton.astro";
import User from "../../icons/User.astro";
import Briefcase from "../../icons/Briefcase.astro";
import Star from "../../icons/Star.astro";
import Mail from "../../icons/Mail.astro";
import Cake from "../../icons/Cake.astro";
import MapPin from "../../icons/MapPin.astro";
import Award from "../../icons/Award.astro";
import ChevronDown from "../../icons/ChevronDown.astro";
import ExternalLink from "../../icons/ExternalLink.astro";
import { profile, certifications } from "../../../data/profile";
import "./summary.css";

const credlyUrl = "https://www.credly.com/users/tetsuro-kawagoe/badges/credly";

const skillGroups = [
  {
    label: "言語",
    items: ["Rust", "Go", "TypeScript", "Python", "Java", "C#", "Dart"],
  },
  {
    label: "フレームワーク",
    items: [
      "Astro",
      "React",
      "Vue",
      "Flutter",
      "ElysiaJS",
      "Huma",
      "FastAPI",
      "Spring Boot",
    ],
  },
  {
    label: "ツール",
    items: [
      "Claude Code",
      "VSCode",
      "Herdr",
      "Obsidian",
      "Postman",
      "TablePlus",
      "draw.io",
      "GIMP",
      "YMM4",
      "Blender",
    ],
  },
];

type SummaryBodyLine = {
  title?: string;
  text: string;
};

const introduction: SummaryBodyLine[] = [
  {
    text: "高校卒業後、1年ほどアルバイトをしてお金を貯め、そのお金で自作PCに挑戦したことがITに興味を持つきっかけになりました。半年ほどJavaの研修を受ける中で数日間学んだLinuxに惹かれ、サーバエンジニアとしてキャリアをスタートしました。",
  },
  {
    text: "LinuxではBindやPostfixなどを扱い、Windows ServerではADやSambaを扱いました。またL3/L2スイッチのルーティングやVLAN設定にも携わりました。",
  },
  {
    text: "その後、仮想化技術に興味を持ち、VMware ESXiによる仮想化基盤やHorizonのVDI環境の設計構築を担当しました。この頃、AnsibleやShellScriptによる自動化に取り組んだことからクラウドへの関心が高まり、AWS環境の仕事を始めました。",
  },
  {
    text: "AWSではCDKやTerraformによるIaC、CodePipelineやGitHub ActionsによるCI/CDの構築を経験し、クラウドならではのFinOps(コスト削減)をしたり、CCoEとしてクラウドシフトを推進しました。",
  },
  {
    text: "インフラ全般の経験を積んだ後は、Java Spring BootによるWebアプリケーション開発やC# WPFによるWindowsデスクトップアプリケーション開発も経験しました。",
  },
  {
    text: "こうした経験を踏まえ、現在は事業会社でClaude Codeを活用したAI駆動開発に取り組んでいます。外部ベンダーの撤退に伴う内製化を背景に、開発環境の整備や運用の自動化、異常通知対応や復旧手順書の作成、バグ修正を主な業務としています。",
  },
];

const recentWork: SummaryBodyLine[] = [
  {
    title: "2重送信・2重課金の不具合修正",
    text: "送信処理において、エラーの握り潰し、不適切なチャネルフォールバック(LINEからSMSへの切替)、DBの冪等性レコード欠如などが原因で2重送信や2重課金が発生する不具合を修正しました。送信内容から一意の冪等性IDを生成しDBに記録することで2重送信を防止しました。また、アプリ内for文による手動リトライをSQSのvisibility timeoutによるリトライへ変更し、スパイク対策も実施しました。",
  },
  {
    title: "通知処理のパフォーマンス改善",
    text: "Web Push APIにおける非アクティブデバイスの不適切な管理、HTTP/1.1接続プールの誤った設定、並行処理の設計に起因するパフォーマンス問題を改善しました。アクティブデバイスのみへの通知配信、接続プール数や並行処理数の見直しにより、エラー率を低下させ、サーバースペックを増強することなくCPU使用率を95%から20%まで削減しました。",
  },
  {
    title: "Frontendビルド時間の短縮",
    text: "モノリシックなfrontendにおいて、ビルド時間を20分から3分へ短縮しました。lintの対象を全ファイルからlint-stagedによる変更ファイルのみへ変更し、minifierをTerserからesbuildへ移行するとともに、適切なchunk分割による重複バンドルの削除やビルドキャッシュの設定見直しを行いました。",
  },
];

const hobby: SummaryBodyLine[] = [
  {
    text: "オクトパストラベラーが好きです。HD-2Dやドット絵、音楽などすべてが最高です! オクトパストラベラー風のドット絵を作りたいなぁと思っていますw",
  },
  {
    text: "また、Tailscaleを利用した自宅サーバ構築にはまっています! 動的IPでもインターネットに無料で公開できるのはありがたいです。まさかオンプレミス回帰するとは...w",
  },
];

const items = [
  {
    icon: User,
    label: "自己紹介",
    body: introduction,
    iconWrapClass: "bg-cyan-500/10",
    iconTextClass: "text-cyan-600 dark:text-cyan-400",
  },
  {
    icon: Briefcase,
    label: "直近の業務",
    body: recentWork,
    iconWrapClass: "bg-amber-500/10",
    iconTextClass: "text-amber-600 dark:text-amber-400",
  },
  {
    icon: Star,
    label: "趣味",
    body: hobby,
    iconWrapClass: "bg-rose-500/10",
    iconTextClass: "text-rose-600 dark:text-rose-400",
  },
];

const contents = [
  {
    label: "Blog",
    date: "2024-01-28",
    description: "AWS SAMを使用したCI/CDの解説",
    image: "/blog.avif",
    width: 1920,
    height: 1080,
    url: "https://zenn.dev/metalmental",
    cta: "Go Blog",
  },
  {
    label: "Youtube",
    date: "2023-11-01",
    description: "ECS Blue/Green Deploymentのゆっくり実況",
    image: "/youtube.avif",
    width: 1000,
    height: 564,
    url: "https://www.youtube.com/@Flupinochan",
    cta: "Go Youtube",
  },
];
---

<SectionHeading id="summary" class="scroll-mt-16" data-summary-title
  >Summary</SectionHeading
>

<div class="divide-y divide-slate-300 dark:divide-slate-700 lg:px-10">
  <div class="summary-profile py-6 opacity-0 invisible">
    <p class="profile-name">
      {
        profile.name.map((part) => (
          <ruby>
            {part.text}
            <rt>{part.ruby}</rt>
          </ruby>
        ))
      }
    </p>
    <p class="mt-1.5 font-semibold">{profile.title}</p>
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      <span class="profile-meta">
        <Cake class="size-4 shrink-0" />
        {profile.age} ({profile.birthday})
      </span>
      <span class="profile-meta">
        <MapPin class="size-4 shrink-0" />
        {profile.location}
      </span>
      <a
        href={`mailto:${profile.email}`}
        class="profile-meta hover:text-violet-500 transition-colors"
      >
        <Mail class="size-4 shrink-0" />
        {profile.email}
      </a>
    </div>
  </div>

  {
    items.map((item) => (
      <div class="summary-row py-6 opacity-0 invisible">
        <div class="flex items-center gap-4">
          <div
            class={`size-9 shrink-0 flex items-center justify-center rounded-full ${item.iconWrapClass} ${item.iconTextClass}`}
          >
            <item.icon />
          </div>
          <p class="text-slate-800 dark:text-slate-100 font-bold">
            {item.label}
          </p>
        </div>
        <div class="mt-3 lg:pl-[3.25rem] flex flex-col gap-2">
          {item.body.map((line, index) => (
            <div
              class:list={[
                "flex flex-col gap-1",
                index > 0 && line.title && "mt-2",
              ]}
            >
              {line.title && (
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">
                  {line.title}
                </p>
              )}
              <p class="text-sm text-slate-700/80 dark:text-slate-300/80 leading-relaxed">
                {line.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <div class="summary-row py-6 opacity-0 invisible">
    <div class="flex items-center gap-4">
      <div
        class="size-9 shrink-0 flex items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      >
        <Award />
      </div>
      <p class="text-slate-800 dark:text-slate-100 font-bold">スキル・資格</p>
    </div>

    <div class="mt-3 lg:pl-[3.25rem] flex flex-col gap-0.5">
      <details name="summary-skill" class="group" data-skill-details>
        <summary class="skill-summary">
          <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
          <p
            class="grow text-sm font-semibold text-slate-800 dark:text-slate-200"
          >
            資格
          </p>
          <span class="text-xs text-slate-400 dark:text-slate-500">
            {certifications.length}
          </span>
          <ChevronDown
            class="size-4.5 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
          />
        </summary>
        <ul class="pt-1 pr-3 pb-3 pl-7 flex flex-col gap-2.5">
          {
            certifications.map((certification) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-emerald-500/50" />
                <p class="text-sm text-slate-700/80 dark:text-slate-300/80 leading-relaxed">
                  {certification}
                </p>
              </li>
            ))
          }
          <li>
            <a
              href={credlyUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-xs text-violet-600 dark:text-violet-400 hover:underline"
            >
              <ExternalLink class="size-4" />
              Credlyで確認
            </a>
          </li>
        </ul>
      </details>

      {
        skillGroups.map((group) => (
          <details name="summary-skill" class="group" data-skill-details>
            <summary class="skill-summary">
              <span class="size-1.5 shrink-0 rounded-full bg-emerald-500" />
              <p class="grow text-sm font-semibold text-slate-800 dark:text-slate-200">
                {group.label}
              </p>
              <span class="text-xs text-slate-400 dark:text-slate-500">
                {group.items.length}
              </span>
              <ChevronDown class="size-4.5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
            </summary>
            <ul class="pt-1 pr-3 pb-3 pl-7 flex flex-col gap-2.5">
              {group.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-emerald-500/50" />
                  <p class="text-sm text-slate-700/80 dark:text-slate-300/80 leading-relaxed">
                    {item}
                  </p>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</div>

<div
  class="grid grid-cols-1 lg:grid-cols-2 gap-y-8 lg:gap-y-0 lg:gap-x-8 lg:px-6 lg:pt-16"
>
  {
    contents.map((content) => (
      <div class="summary-content opacity-0 invisible">
        <p class="text-lg text-slate-800 dark:text-slate-100 font-bold mb-2 lg:mb-8">
          {content.label}
        </p>
        <div class="flex flex-col gap-3 lg:gap-5">
          <img
            src={content.image}
            alt={`${content.label}のサムネイル`}
            width={content.width}
            height={content.height}
            loading="lazy"
            class="w-full h-auto rounded-xl"
          />
          <p class="text-xs text-slate-400 dark:text-slate-500">
            {content.date}
          </p>
          <p class="text-sm text-slate-700/80 dark:text-slate-300/80 leading-relaxed">
            {content.description}
          </p>
          <LinkButton href={content.url} class="self-start">
            {content.cta}
          </LinkButton>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { ScrollTrigger } from "../../../lib/gsap";
  import { initSectionHeadingAnimation } from "../../../lib/sectionHeadingAnimation";

  const summaryTitleEl = document.querySelector("[data-summary-title]");
  if (!summaryTitleEl) {
    throw new Error("Summary title element not found");
  }

  const tl = initSectionHeadingAnimation(summaryTitleEl);

  tl.to(
    ".summary-profile",
    {
      autoAlpha: 1,
      duration: 0.3,
      ease: "power2.out",
    },
    "-=0.2",
  )
    .to(
      ".summary-row",
      {
        autoAlpha: 1,
        stagger: 0.1,
        duration: 0.25,
        ease: "power2.out",
      },
      "-=0.1",
    )
    .to(".summary-content", {
      autoAlpha: 1,
      stagger: 0.15,
      duration: 0.3,
      ease: "power2.out",
    });

  for (const details of document.querySelectorAll("[data-skill-details]")) {
    details.addEventListener("toggle", () => ScrollTrigger.refresh());
  }
</script>
