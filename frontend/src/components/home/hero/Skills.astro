---
import Skill from "./Skill.astro";
import Bracket from "../../icons/Bracket.astro";
import Database from "../../icons/Database.astro";
import Cloud from "../../icons/Cloud.astro";
import Wrench from "../../icons/Wrench.astro";
import type { SkillItem } from "./skill.types";

const skills = [
  {
    icon: Bracket,
    title: "Frontend",
    description:
      "Astroのアイランドアーキテクチャを活かしながら、必要な箇所だけにインタラクションを載せる設計を行います。初期表示速度と保守性のバランスを重視し、コンポーネントの責務分離、アクセシビリティ、テーマ切り替え時の体験まで含めて、継続運用しやすいフロントエンドを実装します。",
    textColor: "text-cyan-500",
    badgeColor: "cyan",
    tooltips: ["React", "Vue", "Flutter", "Slint"],
  },
  {
    icon: Database,
    title: "Backend",
    description:
      "バックエンドでは、API設計とデータモデリングを先に整え、変更に強い実装を優先します。入力検証やエラーハンドリングを明確化し、ログと監視の観点を最初から組み込むことで、障害時の切り分けと復旧を速くできる構成を目指します。",
    textColor: "text-amber-500",
    badgeColor: "amber",
    tooltips: ["SpringBoot", "Gin", "OpenSearch", "Valkey"],
  },
  {
    icon: Cloud,
    title: "Infrastructure",
    description:
      "Infrastructureでは、環境差分を最小化するためにIaCを中心に据え、デプロイ手順の再現性を確保します。ネットワーク、権限、監査ログ、コストの見通しを早い段階から設計に含め、チームが安全に変更できる土台を整えます。",
    textColor: "text-rose-500",
    badgeColor: "rose",
    tooltips: ["AWS", "GCP", "Docker", "VMWare"],
  },
  {
    icon: Wrench,
    title: "SRE",
    description:
      "SREでは、開発速度と信頼性の両立を目的に、監視指標の定義、アラート品質の改善、運用手順の標準化を進めます。障害対応のふりかえりを仕組みに反映し、CI/CDや運用自動化を通じて、継続的に改善が回る状態を作ります。",
    textColor: "text-emerald-500",
    badgeColor: "emerald",
    tooltips: ["OpenTelemetry", "Lighthouse", "k6", "Postman"],
  },
] as const satisfies readonly SkillItem[];
---

<div class="grid grid-cols-2 gap-4">
  {skills.map((skill) => <Skill {...skill} />)}
</div>

<script>
  import { gsap } from "../../../lib/gsap";

  document.addEventListener(
    "home-title-typing-complete",
    async () => {
      gsap.to("[data-skill-card]", {
        duration: 1,
        opacity: 1,
        rotateY: 360,
        transformOrigin: "center center",
        ease: "power2.out",
        stagger: 0.15,
        // アニメーション完了後にskill-cardのクリックを有効化
        onComplete() {
          document
            .querySelectorAll<HTMLElement>("[data-skill-card]")
            .forEach((el) => {
              el.classList.remove("pointer-events-none");
              el.style.cursor = "pointer";
            });
        },
      });
    },
    { once: true },
  );
</script>
