---
import Skill from "./Skill.astro";
import Bracket from "../../icons/Bracket.astro";
import Database from "../../icons/Database.astro";
import Cloud from "../../icons/Cloud.astro";
import Wrench from "../../icons/Wrench.astro";
import type { SkillItem } from "./skill.types";

const skills = [
  {
    icon: Bracket,
    title: "Frontend",
    description:
      "Lighthouse 全スコア 100 を目標に開発します。動的 import・Tree Shaking・AVIF 画像・CSS ネイティブ機能の優先によりパフォーマンスを改善します。FCP / LCP を意識した SSG や CDN と Workbox でキャッシュ・オフライン対応を行いユーザー体験を向上させます。不要な div / span を排除、ARIA ロール・ラベル付与しスクリーンリーダーに対応、Tab / Enter / Esc キーで全操作を可能にし、あらゆるユーザーが操作可能なアクセシブルな UI を実現します。",
    textColor: "text-cyan-500",
    badgeColor: "cyan",
    tooltips: ["React", "Vue", "Flutter", "Slint"],
  },
  {
    icon: Database,
    title: "Backend",
    description:
      "バックエンドでは、API設計とデータモデリングを先に整え、変更に強い実装を優先します。入力検証やエラーハンドリングを明確化し、ログと監視の観点を最初から組み込むことで、障害時の切り分けと復旧を速くできる構成を目指します。",
    textColor: "text-amber-500",
    badgeColor: "amber",
    tooltips: ["SpringBoot", "Gin", "OpenSearch", "Valkey"],
  },
  {
    icon: Cloud,
    title: "Infrastructure",
    description:
      "コストと運用負荷を最小化したインフラを設計します。CPU / Memory / Storage の使用率や未使用リソースを定期的に見直し、適切にサイジングして FinOps を実践します。OS / ミドルウェア / Lambda ランタイムの EOL を管理し、自動アップデートや脆弱性スキャンで常に最新の状態を保ち、ビジネスを失速させません。ログ・リソース変更履歴・権限設定・ネットワークを一括管理し、ガードレールを設けてガバナンスを徹底します。",
    textColor: "text-rose-500",
    badgeColor: "rose",
    tooltips: ["AWS", "GCP", "Docker", "VMWare"],
  },
  {
    icon: Wrench,
    title: "SRE",
    description:
      "Toilの削除、SREでは、開発速度と信頼性の両立を目的に、監視指標の定義、アラート品質の改善、運用手順の標準化を進めます。障害対応のふりかえりを仕組みに反映し、CI/CDや運用自動化を通じて、継続的に改善が回る状態を作ります。",
    textColor: "text-emerald-500",
    badgeColor: "emerald",
    tooltips: ["Grafana", "OpenTelemetry", "Lighthouse", "Postman"],
  },
] as const satisfies readonly SkillItem[];
---

<div class="grid grid-cols-2 gap-4">
  {skills.map((skill) => <Skill {...skill} />)}
</div>

<script>
  import { gsap } from "../../../lib/gsap";

  document.addEventListener(
    "home-title-typing-complete",
    async () => {
      gsap.to("[data-skill-card]", {
        duration: 1,
        opacity: 1,
        rotateY: 360,
        transformOrigin: "center center",
        ease: "power2.out",
        stagger: 0.15,
        // アニメーション完了後にskill-cardのクリックを有効化
        onComplete() {
          document
            .querySelectorAll<HTMLElement>("[data-skill-card]")
            .forEach((el) => {
              el.classList.remove("pointer-events-none");
              el.style.cursor = "pointer";
            });
        },
      });
    },
    { once: true },
  );
</script>
