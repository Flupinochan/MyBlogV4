---
import Skill from "./Skill.astro";
import Bracket from "../../icons/Bracket.astro";
import Database from "../../icons/Database.astro";
import Cloud from "../../icons/Cloud.astro";
import Wrench from "../../icons/Wrench.astro";
import type { SkillItem } from "./skill.types";

const skills = [
  {
    icon: Bracket,
    title: "Frontend",
    description:
      "Lighthouse 全スコア 100 を目標に開発します。動的 import・Tree Shaking・AVIF 画像・CSS ネイティブ機能の優先によりパフォーマンスを改善します。FCP / LCP を意識した SSG や CDN と Workbox でキャッシュ・オフライン対応を行いユーザー体験を向上させます。不要な div / span を排除、ARIA ロール・ラベル付与しスクリーンリーダーに対応、Tab / Enter / Esc キーで全操作を可能にし、あらゆるユーザーが操作可能なアクセシブルな UI を実現します。",
    textColor: "text-cyan-500",
    badgeColor: "cyan",
    tooltips: ["React", "Vue", "Flutter", "Slint"],
  },
  {
    icon: Database,
    title: "Backend",
    description:
      "OpenAPIスキーマから型定義とテストケースを自動生成し、フロントエンドとの整合性とテストの網羅性を担保します。Clean ArchitectureとDDDに基づきUseCaseはRepository・GatewayのInterfaceを介して各処理を実行し、データ取得やビジネスロジックの流れを見通しやすくします。Value Objectとバリデーションでコードの堅牢性を高め、適切な命名規則とコメントで可読性を確保します。AtlasでDBスキーマをバージョン管理し、リトライとキューによる非同期処理でスパイクアクセスや外部サービスの障害に強い構成を実現します。",
    textColor: "text-amber-500",
    badgeColor: "amber",
    tooltips: ["ElysiaJS", "Huma", "FastAPI", "Spring Boot"],
  },
  {
    icon: Cloud,
    title: "Infrastructure",
    description:
      "コストと運用負荷を最小化したインフラを設計します。CPU / Memory / Storage の使用率や未使用リソースを定期的に見直し、適切にサイジングして FinOps を実践します。OS / ミドルウェア / Lambda ランタイムの EOL を管理し、自動アップデートや脆弱性スキャンで常に最新の状態を保ち、ビジネスを失速させません。ログ・リソース変更履歴・権限設定・ネットワークを一括管理し、ガードレールを設けてガバナンスを徹底します。",
    textColor: "text-rose-500",
    badgeColor: "rose",
    tooltips: ["AWS", "K8s", "VMware", "IoT"],
  },
  {
    icon: Wrench,
    title: "SRE",
    description:
      "構造化ログの徹底とメトリクス・トレースの整備、適切なアラート設定により異常を確実に検知します。対応フローと復旧手順もドキュメント化し、経験の浅いエンジニアでも迷わず障害対応できる体制を整えます。Dev ContainerでOSやマシンに依存しない開発環境を用意し、huskyでのlint・formatの自動化とキャッシュ・並列処理を組み込んだCIでtestとbuild検証を自動実行します。commitやPR作成・レビューはAgent Skillで支援し、スピードと品質を両立します。",
    textColor: "text-emerald-500",
    badgeColor: "emerald",
    tooltips: ["Grafana", "OpenTelemetry", "Lighthouse", "Agent Skills"],
  },
] as const satisfies readonly SkillItem[];
---

<div class="grid grid-cols-2 gap-4">
  {skills.map((skill) => <Skill {...skill} />)}
</div>

<script>
  import { gsap } from "../../../lib/gsap";

  document.addEventListener(
    "home-title-typing-complete",
    async () => {
      gsap.to("[data-skill-card]", {
        duration: 1,
        opacity: 1,
        rotateY: 360,
        transformOrigin: "center center",
        ease: "power2.out",
        stagger: 0.15,
        // アニメーション完了後にskill-cardのクリックを有効化
        onComplete() {
          document
            .querySelectorAll<HTMLElement>("[data-skill-card]")
            .forEach((el) => {
              el.classList.remove("pointer-events-none");
              el.style.cursor = "pointer";
            });
        },
      });
    },
    { once: true },
  );
</script>
