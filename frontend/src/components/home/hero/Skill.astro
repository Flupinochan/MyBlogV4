---
import type { SkillItem } from "./skill.types";
import SkillContent from "./SkillContent.astro";

const {
  icon: Icon,
  title,
  textColor,
  tooltips,
  description,
} = Astro.props as SkillItem;

const base = `p-6 rounded-2xl border border-slate-600/70 dark:border-slate-300/70
bg-slate-50/95 dark:bg-slate-900/95 ${textColor} hover:border-current`;
---

<skill-card class="block">
  <div data-skill-card class={`${base} pointer-events-none opacity-0`}>
    <SkillContent
      icon={Icon}
      title={title}
      textColor={textColor}
      tooltips={tooltips}
      description={description}
    />
  </div>

  <div
    data-skill-dialog-backdrop
    class="hidden fixed inset-0 z-50 items-center justify-center
         bg-indigo-950/45 dark:bg-slate-950/70 backdrop-blur-sm"
  >
    <div data-skill-dialog class={`${base} w-[min(92vw,32rem)]`}>
      <SkillContent
        icon={Icon}
        title={title}
        textColor={textColor}
        tooltips={tooltips}
        description={description}
      />
    </div>
  </div>
</skill-card>

<script>
  // 3D Tilt Effect (View Transitionに干渉しないよう注意)
  (() => {
    document
      .querySelectorAll<HTMLElement>("[data-skill-card]")
      .forEach((card) => {
        card.addEventListener("mousemove", function (e: MouseEvent) {
          const rect = card.getBoundingClientRect();
          const rotateX = (e.clientY - rect.top - rect.height / 2) / 10;
          const rotateY = (rect.width / 2 - (e.clientX - rect.left)) / 10;

          card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
        });

        card.addEventListener("mouseleave", function () {
          card.style.transform =
            "perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
        });
      });
  })();

  class SkillCard extends HTMLElement {
    connectedCallback() {
      const skillCard = this.querySelector<HTMLElement>("[data-skill-card]");
      const skillDialog = this.querySelector<HTMLElement>(
        "[data-skill-dialog]",
      );
      const skillDialogBackdrop = this.querySelector<HTMLElement>(
        "[data-skill-dialog-backdrop]",
      );
      const skillCloseBtns = this.querySelectorAll<HTMLElement>(
        "[data-close-button]",
      );
      const skillDialogCloseBtn = skillDialog?.querySelector<HTMLElement>(
        "[data-close-button]",
      );

      const skillTitle =
        this.querySelectorAll<HTMLElement>("[data-skill-title]");
      const skillTooltips = this.querySelectorAll<HTMLElement>(
        "[data-skill-tooltip]",
      );
      const skillDescription = this.querySelectorAll<HTMLElement>(
        "[data-skill-description]",
      );
      const skillDialogDescription = skillDialog?.querySelector<HTMLElement>(
        "[data-skill-description-wrapper]",
      );
      const svgIcon = this.querySelectorAll<SVGElement>("svg");
      if (
        !skillCard ||
        !skillDialog ||
        !skillDialogBackdrop ||
        skillCloseBtns.length === 0 ||
        !skillDialogCloseBtn ||
        skillTitle.length === 0 ||
        skillTooltips.length === 0 ||
        skillDescription.length === 0 ||
        !skillDialogDescription ||
        svgIcon.length === 0
      ) {
        throw new Error("SkillCard: 必要な要素が見つかりませんでした");
      }

      const clearViewTransitionNames = () => {
        // 全てのSkillCard/SkillDialogのview transition nameをリセット
        const all = this.querySelectorAll<HTMLElement>(
          "[data-skill-card], [data-skill-dialog], [data-close-button], [data-skill-title], [data-skill-tooltip], [data-skill-description], svg",
        );
        all.forEach((el) => {
          el.style.removeProperty("view-transition-name");
          el.style.removeProperty("view-transition-class");
        });
      };

      const setViewTransitionNames = () => {
        // 本SkillCardの要素にview transition nameをセット
        skillCard.style.viewTransitionName = "skill-card-main";
        skillCard.style.viewTransitionClass = "skill-card-transition";
        skillDialog.style.viewTransitionName = "skill-card-main";
        skillDialog.style.viewTransitionClass = "skill-card-transition";
        skillCloseBtns.forEach((el) => {
          el.style.viewTransitionName = "skill-close-button";
          el.style.viewTransitionClass = "skill-card-transition";
        });
        skillTitle.forEach((el) => {
          el.style.viewTransitionName = "skill-title";
          el.style.viewTransitionClass = "skill-card-transition";
        });
        skillTooltips.forEach((el) => {
          const id = el.getAttribute("data-skill-tooltip");
          el.style.viewTransitionName = `skill-tooltip-${id}`;
          el.style.viewTransitionClass = "skill-card-transition";
        });
        skillDescription.forEach((el) => {
          el.style.viewTransitionName = "skill-description";
          el.style.viewTransitionClass = "skill-card-transition";
        });
        svgIcon.forEach((el) => {
          el.style.viewTransitionName = "skill-svg-icon";
          el.style.viewTransitionClass = "skill-card-transition";
        });
      };

      const toggle = async (showDialog: boolean) => {
        // View Transitionが利用できない古いブラウザ向けのフォールバック
        if (!document.startViewTransition) {
          skillCard.classList.toggle("hidden", showDialog);
          skillDialogBackdrop.classList.toggle("hidden", !showDialog);
          skillDialogBackdrop.style.display = showDialog ? "flex" : "none";
          skillDialogCloseBtn.classList.toggle("close-button", showDialog);
          skillDialogCloseBtn.style.opacity = showDialog ? "1" : "0";
          skillDialogCloseBtn.style.height = showDialog ? "auto" : "0";
          skillDialogDescription.classList.toggle(
            "skill-card-description",
            !showDialog,
          );
          return;
        }

        // transition開始
        try {
          // view transition name, 共通アニメーション設定view transition classを付与
          setViewTransitionNames();

          // elementレベルのstartViewTransitionは、position: fixedやpopoverでは扱えないため注意
          // ここではdialog表示のためにposition: fixedを利用しているため、documentレベルで実行
          await document.startViewTransition(() => {
            skillCard.classList.toggle("hidden", showDialog);
            skillDialogBackdrop.classList.toggle("hidden", !showDialog);
            skillDialogBackdrop.style.display = showDialog ? "flex" : "none";
            skillDialogCloseBtn.classList.toggle("close-button", showDialog);
            skillDialogCloseBtn.style.opacity = showDialog ? "1" : "0";
            skillDialogCloseBtn.style.height = showDialog ? "auto" : "0";
            skillDialogDescription.classList.toggle(
              "skill-card-description",
              !showDialog,
            );
          }).finished;
        } finally {
          clearViewTransitionNames();
          this.style.removeProperty("view-transition-class");
          skillCard.style.removeProperty("view-transition-class");
          skillDialog.style.removeProperty("view-transition-class");
          skillCard.style.borderColor = "";
        }
      };

      skillCard.addEventListener("click", () => {
        // hover時のborder colorのままview transitionするため
        skillCard.style.borderColor = getComputedStyle(skillCard).color;
        skillDialog.style.borderColor = getComputedStyle(skillCard).color;
        toggle(true);
      });
      skillDialogCloseBtn.addEventListener("click", () => toggle(false));
      skillDialogBackdrop?.addEventListener(
        "click",
        (e) => e.target === skillDialogBackdrop && toggle(false),
      );
    }
  }

  if (!customElements.get("skill-card")) {
    customElements.define("skill-card", SkillCard);
  }
</script>

<style is:global>
  ::view-transition-group(.skill-card-transition) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    /* ellipsisでフェードインする際にoldの要素内にnewが収まるようにclip */
    overflow: clip;
  }

  ::view-transition-image-pair(.skill-card-transition) {
    animation: none;
  }

  /* フェードアウト */
  ::view-transition-old(.skill-card-transition) {
    animation: fade-out 0.5s ease forwards;
  }

  /* フェードイン */
  ::view-transition-new(.skill-card-transition) {
    animation: fade-in 0.5s ease forwards;
  }

  ::view-transition-old(.skill-card-transition),
  ::view-transition-new(.skill-card-transition) {
    /* 要素サイズが変わり、borderなどが伸び縮みする際は必須 */
    height: 100%;
    width: 100%;
  }

  ::view-transition-old(skill-description),
  ::view-transition-new(skill-description) {
    /* ellipsisをアニメーションする際は必須 */
    object-fit: none;
    object-position: top left;
  }

  @keyframes fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .close-button {
    margin-top: 16px;
    padding-inline: 16px;
    padding-block: 8px;
  }
</style>
