---
import { getGitHubCommitStats } from "./githubStats";

const commitStats = await getGitHubCommitStats();
---

<div id="stack-chart" data-commits={JSON.stringify(commitStats)}></div>

<script>
  import * as d3 from "d3";
  import type { GitHubCommitCount } from "../../../types/github";

  const stackContainer = document.getElementById("stack-chart");
  if (!stackContainer) throw new Error("Stack chart container not found");

  const commitCount: GitHubCommitCount[] = JSON.parse(
    stackContainer.dataset.commits ?? "[]",
  );

  const width = 500;
  const height = 500;
  const margin = 60;

  const svg = d3
    .select("#stack-chart")
    .append("svg")
    .attr("width", width)
    .attr("height", height);

  // X Axis Year-Month Scale
  const x = d3
    .scaleTime()
    .domain(d3.extent(commitCount, (d) => new Date(d.date)) as [Date, Date])
    .range([margin, width - margin]);

  // Y Axis Total Commits Scale
  const totalCommits = commitCount[commitCount.length - 1]?.total || 0;
  const y = d3
    .scaleLinear()
    .domain([0, totalCommits])
    .nice()
    .range([height - margin, margin]);

  // X Axis Year-Month Scale format
  svg
    .append("g")
    .attr("transform", `translate(0, ${height - margin})`)
    .call(
      d3
        .axisBottom(x)
        .ticks(5)
        .tickFormat(d3.timeFormat("%Y-%m") as any),
    );

  // Y Axis Total Commits Scale format
  svg
    .append("g")
    .attr("transform", `translate(${margin}, 0)`)
    .call(d3.axisLeft(y).ticks(6).tickFormat(d3.format(",d")));

  // Area generator
  const area = d3
    .area<GitHubCommitCount>()
    .x((d) => x(new Date(d.date)))
    .y0(y(0))
    .y1((d) => y(d.total))
    .curve(d3.curveMonotoneX);

  svg
    .append("path")
    .datum(commitCount)
    .attr("fill", "steelblue")
    .attr("fill-opacity", 0.2)
    .attr("stroke", "steelblue")
    .attr("stroke-width", 2)
    .attr("d", area);
</script>
