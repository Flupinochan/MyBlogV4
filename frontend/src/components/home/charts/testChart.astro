---
import {
  getGitHubLanguageBytesStats,
  getRepositoryCountByLanguage,
  getGitHubCommitStats,
} from "./githubStats";

const langCount = await getRepositoryCountByLanguage();
const langBytes = await getGitHubLanguageBytesStats();
const commitStats = await getGitHubCommitStats();
---

<div class="chart-wrapper">
  <div class="radio-group">
    <label class="radio-label">
      <input type="radio" name="chart-type" value="pie" checked />
      <span>Language Count</span>
    </label>
    <label class="radio-label">
      <input type="radio" name="chart-type" value="bar" />
      <span>Language Bytes</span>
    </label>
    <label class="radio-label">
      <input type="radio" name="chart-type" value="stack" />
      <span>Commit Stack</span>
    </label>
  </div>

  <div
    id="unified-chart"
    data-stats={JSON.stringify(langCount)}
    data-bytes={JSON.stringify(langBytes)}
    data-commits={JSON.stringify(commitStats)}
  >
  </div>
</div>

<style>
  .chart-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 20px;
  }
  .radio-group {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .radio-label {
    cursor: pointer;
    padding: 8px 16px;
    background: #f0f0f0;
    color: #555555;
    border-radius: 4px;
    font-size: 14px;
    transition: background 0.3s;
  }
  .radio-label:has(input:checked) {
    background: #d4b8ff;
    color: white;
  }
  .radio-label input {
    display: none;
  }
</style>

<!-- インラインスクリプトをすべてindex.tsに移動 -->
<script>
  import "./index";
</script>
