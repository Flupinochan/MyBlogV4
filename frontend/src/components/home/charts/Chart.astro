---
import SectionHeading from "../../shared/SectionHeading.astro";
import PieChart from "../../icons/PieChart.astro";
import BarChart from "../../icons/BarChart.astro";
import TrendChart from "../../icons/TrendChart.astro";

const isDev = import.meta.env.MODE === "development";

const mod = isDev
  ? await import("./githubStatsMock")
  : await import("./githubStats");

const {
  getGitHubLanguageBytesStats,
  getRepositoryCountByLanguage,
  getGitHubCommitStats,
} = mod;

const langCount = await getRepositoryCountByLanguage();
const langBytes = await getGitHubLanguageBytesStats();
const commitStats = await getGitHubCommitStats();
---

<SectionHeading accent="rose" data-chart-title>See Me in Charts</SectionHeading>

<div class="flex items-center gap-10 mt-10">
  <div class="radio-group">
    <label data-anchor="pie" class="radio-label [anchor-name:--pie]">
      <input
        type="radio"
        name="chart-type"
        value="pie"
        class="hidden"
        checked
      />
      <div class="flex gap-2">
        <PieChart />
        <p class="radio-title">Language Count</p>
      </div>
      <p class="radio-description">
        各リポジトリのメイン言語を抽出し、多種多様な言語への対応力を可視化
      </p>
    </label>

    <label data-anchor="bar" class="radio-label [anchor-name:--bar]">
      <input type="radio" name="chart-type" value="bar" class="hidden" />
      <div class="flex gap-2">
        <BarChart />
        <p class="radio-title">Language Bytes</p>
      </div>
      <p class="radio-description">
        総コード記述量を言語別に集計し、技術的な習熟度をボリュームで表現
      </p>
    </label>

    <label data-anchor="stack" class="radio-label [anchor-name:--stack]">
      <input type="radio" name="chart-type" value="stack" class="hidden" />
      <div class="flex gap-2">
        <TrendChart />
        <p class="radio-title">Total Commits</p>
      </div>
      <p class="radio-description">
        全期間のコミット累計から読み取る開発の持続性
      </p>
    </label>
  </div>

  <div
    id="unified-chart"
    class="w-full"
    data-stats={JSON.stringify(langCount)}
    data-bytes={JSON.stringify(langBytes)}
    data-commits={JSON.stringify(commitStats)}
  >
  </div>
</div>

<!-- darkを利用するためにglobalで定義 -->
<style is:global>
  /* @applyを有効化
    @applyを利用することで通常のCSSファイル内でTailwind CSSの
    ユーティリティクラスを使用可能にする
  */
  @reference "../../../styles/global.css";
  @variant dark (&:where(.dark, .dark *));

  /* group */
  .radio-group {
    @apply relative flex flex-col gap-8;
  }
  .radio-group::before {
    content: "";
    @apply absolute pointer-events-none z-0 rounded
           transition-all duration-400
           ease-[cubic-bezier(0.34,1.56,0.64,1)]
           bg-violet-500/20 dark:bg-violet-800/50;

    position-anchor: var(--active-anchor);
    top: anchor(top);
    left: anchor(left);
    right: anchor(right);
    bottom: anchor(bottom);
  }

  /* normal */
  .radio-label {
    @apply relative z-10 p-4
           opacity-0 invisible
           border-2 border-slate-500 dark:border-slate-400
           rounded cursor-pointer
           transition-all duration-150
           active:translate-y-0.5 active:scale-95;
  }
  .radio-title {
    @apply text-slate-800 dark:text-slate-100 font-bold whitespace-nowrap;
  }
  .radio-description {
    @apply text-sm mt-2 text-slate-700/80 dark:text-slate-300/80 leading-relaxed;
  }

  /* checked */
  .radio-label:has(input:checked) {
    @apply border-violet-600 dark:border-violet-400;
  }
  .radio-group:has(input[value="pie"]:checked) {
    --active-anchor: --pie;
  }
  .radio-group:has(input[value="bar"]:checked) {
    --active-anchor: --bar;
  }
  .radio-group:has(input[value="stack"]:checked) {
    --active-anchor: --stack;
  }

  /* hover */
  .radio-group:has(label[data-anchor="pie"]:hover) {
    --active-anchor: --pie;
  }
  .radio-group:has(label[data-anchor="bar"]:hover) {
    --active-anchor: --bar;
  }
  .radio-group:has(label[data-anchor="stack"]:hover) {
    --active-anchor: --stack;
  }
</style>

<script>
  import { initChartAnimation, isAnimating } from "./main";
  import { initSectionHeadingAnimation } from "../../../lib/sectionHeadingAnimation";

  const chartTitleEl = document.querySelector("[data-chart-title]");
  if (!chartTitleEl) {
    throw new Error("Chart title element not found");
  }

  const tl = initSectionHeadingAnimation(chartTitleEl, {
    onStart: () => isAnimating.set(true),
    onComplete: () => isAnimating.set(false),
  });

  tl.to(
    ".radio-label",
    {
      autoAlpha: 1,
      stagger: 0.1,
      duration: 0.25,
      ease: "power2.out",
    },
    "-=0.2",
  );
  tl.add(initChartAnimation(), "+=0.25");
</script>
