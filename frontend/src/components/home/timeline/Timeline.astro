---
import SectionHeading from "../../shared/SectionHeading.astro";

const items = [
  {
    year: 2019,
    title: "Title A",
    desc: "Description placeholder.",
    color: "var(--color-cyan-500)",
  },
  {
    year: 2021,
    title: "Title B",
    desc: "Description placeholder.",
    color: "var(--color-emerald-500)",
  },
  {
    year: 2022,
    title: "Title C",
    desc: "Description placeholder.",
    color: "var(--color-amber-500)",
  },
  {
    year: 2024,
    title: "Title C",
    desc: "Description placeholder.",
    color: "var(--color-pink-500)",
  },
  {
    year: 2026,
    title: "Title D",
    desc: "Description placeholder.",
    color: "var(--color-violet-500)",
  },
];
---

<SectionHeading accent="cyan" class="mb-16" data-timeline-title
  >See Me in Timeline</SectionHeading
>

<div id="tl-wrap" class="relative mx-16">
  <div
    id="tl-start"
    class="text-center font-semibold pb-3"
    style={`color: ${items[0].color}`}
  >
    高校卒業
  </div>

  <div class="flex flex-col gap-30 mt-35">
    {
      items.map((item, i) => (
        <div
          class={`tl-row flex justify-between items-center p-4${i % 2 !== 0 ? " flex-row-reverse" : ""}`}
          data-color={item.color}
        >
          <h3 class="text-5xl font-bold" style={`color: ${item.color}`}>
            {item.year}
          </h3>
          <div class={i % 2 !== 0 ? "" : "text-right"}>
            <p class="font-bold text-slate-100">{item.title}</p>
            <p class="text-sm text-slate-400">{item.desc}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div
    id="tl-end"
    class="text-center font-semibold pt-3 mt-5"
    style={`color: ${items[items.length - 1].color}`}
  >
    現在
  </div>

  <!-- 親要素divと同じ位置、同じサイズの背景用timeline svg -->
  <svg class="absolute -z-1 inset-0 w-full h-full">
    <defs>
      <linearGradient
        id="timelineGradient"
        gradientUnits="userSpaceOnUse"
        x1="0"
        y1="0"
        x2="0"
        y2="1"
      >
      </linearGradient>
    </defs>

    <path
      id="tl-path"
      fill="none"
      stroke="url(#timelineGradient)"
      stroke-width="2"
      stroke-linecap="round"></path>

    <g id="tl-dots"></g>
  </svg>
</div>

<script>
  import { gsap } from "../../../lib/gsap";
  import { initSectionHeadingAnimation } from "../../../lib/sectionHeadingAnimation";

  const wrap = document.getElementById("tl-wrap") as HTMLDivElement | null;
  const path = document.getElementById("tl-path") as SVGPathElement | null;
  const start = document.getElementById("tl-start") as HTMLDivElement | null;
  const end = document.getElementById("tl-end") as HTMLDivElement | null;
  const gradient = document.getElementById(
    "timelineGradient",
  ) as SVGLinearGradientElement | null;

  let tween: gsap.core.Tween | undefined;

  function draw() {
    if (!wrap) throw new Error("Timeline wrap element not found");
    if (!path) throw new Error("Timeline path element not found");
    if (!start) throw new Error("Timeline start element not found");
    if (!end) throw new Error("Timeline end element not found");
    if (!gradient) throw new Error("Timeline gradient element not found");

    // getBoundingClientRect()で要素のtopやright座標を取得する際に
    // paddingは考慮するが、marginは考慮しないため注意
    const wrapRect = wrap.getBoundingClientRect();
    const wrapWidth = wrapRect.width;
    const wrapHeight = wrapRect.height;
    const wrapCenterX = wrapRect.width / 2;

    // x軸と違い、y軸は20xx要素ごとに高さが異なるため計算が必要
    // svgは左上座標(0,0)が基準のため、親要素のwrapからの相対位置でy座標を計算する関数
    // rowのbottomのy座標を計算する関数
    const bottomY = (el: Element) => {
      const rect = el.getBoundingClientRect();
      return rect.bottom - wrapRect.top;
    };
    const endY = (el: Element) => {
      const rect = el.getBoundingClientRect();
      return rect.top - wrapRect.top;
    };

    tween?.scrollTrigger?.kill();
    tween?.kill();

    const strokeWidthHalf = 1; // stroke-widthの半分 (端でpathが半分見切れるため)

    const startBottomY = bottomY(start);
    const endTopY = endY(end);
    const rows = Array.from(document.querySelectorAll<HTMLElement>(".tl-row"));
    const rowBottomYs = rows.map(bottomY);
    const rowColors = rows.map((el) => {
      if (!el.dataset.color) throw new Error("tl-row is missing data-color");
      return el.dataset.color;
    });

    // y1からy2(縦方向)へgradient
    gradient.setAttribute("y2", String(wrapHeight));
    // observe対策として一度削除
    while (gradient.firstChild) gradient.removeChild(gradient.firstChild);
    rowColors.forEach((color, idx) => {
      const stop = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "stop",
      );
      // rowごとのrowBottomYsにstopを設定
      stop.setAttribute(
        "offset",
        String(Math.min(1, Math.max(0, rowBottomYs[idx] / wrapHeight))),
      );
      stop.style.stopColor = color;
      gradient.appendChild(stop);
    });

    let d = `M ${wrapCenterX} ${startBottomY}`; // 高校卒業の要素のbottomへ移動
    d += ` l 0 20`; // 下へ20px線を引く (gap-30 mt-35 mb-5 と合わせて調整)
    d += ` l -${wrapCenterX - strokeWidthHalf} 0`;
    for (let i = 0; i < rowBottomYs.length; i++) {
      const isEven = i % 2 === 0;
      const entryX = isEven ? strokeWidthHalf : wrapWidth - strokeWidthHalf;
      const exitX = isEven ? wrapWidth - strokeWidthHalf : strokeWidthHalf;
      const entryY =
        i === 0 ? rowBottomYs[i] : rowBottomYs[i] - strokeWidthHalf;
      d += ` L ${entryX} ${entryY}`;
      if (i < rowBottomYs.length - 1) {
        d += ` L ${exitX} ${rowBottomYs[i] - strokeWidthHalf}`;
      } else {
        d += ` L ${wrapCenterX} ${rowBottomYs[i]}`;
      }
    }
    d += ` L ${wrapCenterX} ${endTopY}`; // 現在の要素のtopへ線を引く

    path.setAttribute("d", d);

    // gsap drawSVG + ScrollTrigger
    // 0% -> 100% へ scrub1 でスクロールに連動してpathを絵画
    tween = gsap.fromTo(
      path,
      { drawSVG: "0%" },
      {
        drawSVG: "100%",
        ease: "none",
        scrollTrigger: {
          trigger: "#tl-wrap",
          start: "top 60%",
          end: "bottom center",
          scrub: 1,
        },
      },
    );
  }

  draw();

  if (!wrap) throw new Error("Timeline wrap element not found");
  const ro = new ResizeObserver(draw);
  ro.observe(wrap);

  const title = document.querySelector("[data-timeline-title]");
  if (!title) throw new Error("Timeline title element not found");
  initSectionHeadingAnimation(title);
</script>
