---
import type { SkillItem } from "./skill.types";

const {
  icon: Icon,
  title,
  textColor,
  tooltips,
  description,
} = Astro.props as SkillItem;
---

<Icon />
<p
  data-skill-title
  style="width: fit-content;"
  class={`mt-3 text-lg font-semibold whitespace-nowrap ${textColor}`}
>
  {title}
</p>
{
  tooltips.length > 0 && (
    <div class={`mt-2 flex flex-wrap gap-1.5 ${textColor}`}>
      {tooltips.map((item, index) => (
        <span
          data-skill-tooltip={index}
          class="rounded-md border border-current/30 bg-current/10 px-2 py-0.5 text-[11px] font-medium leading-none"
        >
          {item}
        </span>
      ))}
    </div>
  )
}
<p
  data-skill-description
  class="skill-desc-text mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300"
>
  {description}
</p>
