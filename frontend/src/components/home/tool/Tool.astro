---
import ToolTable from "./ToolTable.tsx";
---

<h2
  class="text-center text-6xl font-bold mt-20 text-violet-500"
  data-tool-title
>
  My Tools
</h2>

<ToolTable client:idle />

<script>
  import { gsap } from "../../../lib/gsap";
  import { SplitText } from "gsap/SplitText";

  const toolTitleEl = document.querySelector("[data-tool-title]");
  if (!toolTitleEl) {
    throw new Error("Tool title element not found");
  }

  const splitText = new SplitText(toolTitleEl, { type: "chars" });
  gsap.set(splitText.chars, {
    autoAlpha: 0,
    filter: "blur(10px)",
  });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: toolTitleEl,
      start: "top 50%",
      toggleActions: "play none none none",
    },
  });
  tl.to(splitText.chars, {
    autoAlpha: 1,
    filter: "blur(0px)",
    duration: 0.25,
    stagger: 0.02,
    ease: "power2.out",
  })
    .to(
      ".tools-columns-open-button",
      {
        autoAlpha: 1,
        stagger: 0.1,
        duration: 0.25,
        ease: "power2.out",
      },
      "-=0.2",
    )
    // DOMの描画タイミングの都合上、onComplete後に各rowのアニメーションを開始
    .to(".tool-table", {
      autoAlpha: 1,
      duration: 0.25,
      delay: 0.35,
      ease: "power2.out",
      onComplete: () => {
        const rows = gsap.utils.toArray(".tool-table-row");
        gsap
          .timeline({
            onComplete: () => {
              document
                .querySelector(".tool-table")
                ?.classList.add("rows-animated");
            },
          })
          .fromTo(
            rows,
            { x: -40 },
            { x: 0, stagger: 0.08, duration: 0.35, ease: "power2.out" },
          )
          .fromTo(
            rows,
            { autoAlpha: 0 },
            { autoAlpha: 1, stagger: 0.08, duration: 0.5, ease: "power1.out" },
            "<",
          );
      },
    });
</script>
