---
import ToolTable from "./ToolTable.tsx";
import SectionHeading from "../../shared/SectionHeading.astro";
---

<SectionHeading accent="amber" class="mb-16" data-tool-title
  >See Me in Code</SectionHeading
>

<ToolTable client:idle />

<script>
  import { gsap } from "../../../lib/gsap";
  import { initSectionHeadingAnimation } from "../../../lib/sectionHeadingAnimation";

  const toolTitleEl = document.querySelector("[data-tool-title]");
  if (!toolTitleEl) {
    throw new Error("Tool title element not found");
  }

  const tl = initSectionHeadingAnimation(toolTitleEl);

  tl.to(
    ".tools-columns-open-button",
    {
      autoAlpha: 1,
      stagger: 0.1,
      duration: 0.25,
      ease: "power2.out",
    },
    "-=0.2",
  )
    // DOMの描画タイミングの都合上、onComplete後に各rowのアニメーションを開始
    .to(".tool-table", {
      autoAlpha: 1,
      duration: 0.25,
      delay: 0.35,
      ease: "power2.out",
      onComplete: () => {
        const rows = gsap.utils.toArray(".tool-table-row");
        gsap
          .timeline({
            onComplete: () => {
              document
                .querySelector(".tool-table")
                ?.classList.add("rows-animated");
            },
          })
          .fromTo(
            rows,
            { x: -40 },
            { x: 0, stagger: 0.08, duration: 0.35, ease: "power2.out" },
          )
          .fromTo(
            rows,
            { autoAlpha: 0 },
            { autoAlpha: 1, stagger: 0.08, duration: 0.5, ease: "power1.out" },
            "<",
          );
      },
    });
</script>
