<button>Click Me</button>

<script>
  import { dispatchShapeKey } from "./avatar/shapeKey";

  const audio = new Audio("/voice/hello.wav");

  audio.addEventListener("ended", () => {
    dispatchShapeKey("vrc.v_sil");
  });

  const button = document.querySelector("button");
  button?.addEventListener("click", () => {
    audio.currentTime = 0;
    dispatchShapeKey("vrc.v_aa");
    audio.play();
  });
</script>
