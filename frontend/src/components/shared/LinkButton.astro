---
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: extraClass = "", ...rest } = Astro.props;

const isExternal = href.startsWith("http");

const classes = ["outline-button", extraClass].filter(Boolean).join(" ");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
  class={classes}
  {...rest}
>
  <slot />
</a>
