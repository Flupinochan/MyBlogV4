---
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: extraClass = "", ...rest } = Astro.props;

const isExternal = href.startsWith("http");

const classes = [
  "relative inline-flex items-center overflow-hidden rounded-xl",
  "border border-violet-500 px-5 py-2 text-sm font-medium",
  "text-violet-600 dark:text-violet-400",
  "transition-colors duration-300 ease-out hover:text-white",
  "active:translate-y-0.5",
  "after:absolute after:inset-y-0 after:left-0 after:-z-10 after:w-0",
  "after:bg-violet-500 after:transition-all after:duration-300 after:ease-out",
  "hover:after:w-full",
  extraClass,
]
  .filter(Boolean)
  .join(" ");
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
  class={classes}
  {...rest}
>
  <slot />
</a>
