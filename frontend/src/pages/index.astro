---
import Layout from "../layouts/Base.astro";
import MainTitle from "../components/home/MainTitle.astro";
---

<Layout>
  <section class="text-center pt-40">
    <MainTitle />
    <a href="/used-tech">Used Tech</a>
    {
      Array.from({ length: 100 }, (_, i) => (
        <p>
          これはサンプルテキストです。番号: {i + 1}.
          コンテンツを増やして、スクロールバー表示を確認します。
        </p>
      ))
    }
  </section>
</Layout>
