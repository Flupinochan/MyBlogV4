---
import Layout from "../layouts/Base.astro";
import HomeTitle from "../components/layout/HomeTitle.astro";
import { getAccentColor } from "../layouts/ThemeColor";
---

<Layout>
  <section class="text-center">
    <h1 class="text-2xl font-bold">
      <HomeTitle
        prefix="MetalMental is a "
        suffix=" engineer"
        words={[
          { text: "Infra", color: getAccentColor("rose") },
          { text: "Frontend", color: getAccentColor("cyan") },
          { text: "Backend", color: getAccentColor("amber") },
          { text: "SRE", color: getAccentColor("emerald") },
          { text: "Full-Stack", color: getAccentColor("violet") },
        ]}
      />
    </h1>
    <a href="/used-tech">Used Tech</a>
    {
      Array.from({ length: 100 }, (_, i) => (
        <p>
          これはサンプルテキストです。番号: {i + 1}.
          コンテンツを増やして、スクロールバー表示を確認します。
        </p>
      ))
    }
  </section>
</Layout>
