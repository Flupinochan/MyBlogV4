---
import Layout from "../layouts/Base.astro";
import MainTitle from "../components/home/MainTitle.astro";
import Skills from "../components/home/Skills.astro";
import Flex from "../components/layout/Flex.astro";
import HeroActions from "../components/home/HeroActions.astro";
import Chart from "../components/home/charts/Chart.astro";
---

<Layout>
  <!-- MainTitleとSkillsは画面の初期画面の中央に配置 -->
  <Flex class="flex-col items-center justify-center min-h-[calc(100dvh-200px)]">
    <MainTitle />
    <Skills />
    <HeroActions />
  </Flex>
  <Chart />
</Layout>
